{
  "name": "oh-my-dsh-slim",
  "version": "0.5.0",
  "description": "oh-my-opencode-slim-style specialist subagent delegation preset for DeepSeek Harness — ships the preset and seeds it into your DSH home automatically.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninipa/oh-my-dsh-slim.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "agent-preset",
    "subagent",
    "oh-my-opencode-slim"
  ],
  "files": [
    "client",
    "lib",
    "preset",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-rc.1 <0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
