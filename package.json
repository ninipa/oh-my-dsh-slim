{
  "name": "oh-my-dsh-slim",
  "version": "0.8.1",
  "description": "oh-my-opencode-slim-style specialist subagent delegation preset for DeepSeek Harness — a declarative agent preset with an orchestrator prompt and six specialist roles plus a three-seat council, background-first delegation, and JSON-driven per-role configuration.",
  "license": "MIT",
  "type": "module",
  "main": "npm-package/lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninipa/oh-my-dsh-slim.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "agent-preset",
    "subagent",
    "oh-my-opencode-slim"
  ],
  "exports": {
    ".": "./npm-package/lib/index.js",
    "./preset": "./npm-package/preset/preset.js",
    "./profile-registry": "./npm-package/lib/profile-registry.js",
    "./client": "./npm-package/client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "semver": "7.7.2"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
