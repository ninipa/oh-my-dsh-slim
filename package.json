{
  "name": "oh-my-dsh-slim",
  "version": "0.6.1-native.3",
  "description": "oh-my-opencode-slim-style specialist subagent delegation preset for DeepSeek Harness — a declarative agent preset with an orchestrator prompt and six specialist roles, background-first delegation, and JSON-driven per-role configuration.",
  "license": "MIT",
  "type": "module",
  "main": "npm-package/lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Henry-916/oh-my-dsh-slim.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "agent-preset",
    "subagent",
    "oh-my-opencode-slim"
  ],
  "exports": {
    ".": "./npm-package/lib/index.js",
    "./client": "./npm-package/client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.0-rc.2"
  }
}
